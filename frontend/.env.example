# Required for Microsoft sign-in. Copy this file to .env.local and fill
# in values from your Entra ID App Registration (see docs/SETUP.md).
# Vite only loads .env.local after a restart — stop and re-run
# `npm run dev` after editing it.

# Application (client) ID — Entra ID App Registration → Overview
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID — Entra ID App Registration → Overview
VITE_ENTRA_TENANT_ID=

# Must exactly match a redirect URI registered on the app's
# "Single-page application" platform (Authentication blade).
VITE_REDIRECT_URI=http://localhost:5173

# Only needed if the backend isn't reachable at the default `/api`
# (e.g. no dev-server proxy, or a different backend host/port).
# VITE_API_BASE=http://localhost:8000/api
