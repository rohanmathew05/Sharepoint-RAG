# --- Microsoft Entra ID (App Registration) ---
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-client-id
ENTRA_CLIENT_SECRET=your-app-client-secret
GRAPH_SCOPE=https://graph.microsoft.com/.default

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- App ---
FRONTEND_ORIGIN=http://localhost:5173
MAX_SEARCH_RESULTS=8
MAX_RAG_CONTEXT_CHARS=12000

# Set to false once real Entra ID / Graph / Azure OpenAI credentials above
# are filled in. When true, the backend uses local fixture SharePoint data
# and two demo users (see backend/services/demo_data.py) so the
# permission-aware retrieval model can be demonstrated without a tenant.
DEMO_MODE=true
